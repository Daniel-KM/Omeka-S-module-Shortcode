{
    "name": "daniel-km/omeka-s-module-shortcode",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Insert shortcuts in site pages in order to render more content via a simple string like `[shortcode]`.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "shortcode",
        "view"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-Shortcode",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-Shortcode/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.0",
        "daniel-km/omeka-s-module-common": "*"
    },
    "autoload": {
        "psr-4": {
            "Shortcode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShortcodeTest\\": "tests/ShortcodeTest/"
        }
    },
    "extra": {
        "installer-name": "Shortcode"
    }
}
